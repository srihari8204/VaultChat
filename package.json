    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:android:apk": "node scripts/check-sdk-versions.js && expo prebuild --platform android --clean && node scripts/gradlew.js assembleRelease",
    "build:android:aab": "node scripts/check-sdk-versions.js && expo prebuild --platform android --clean && node scripts/gradlew.js bundleRelease",
    "eas:build:android:preview": "eas build --platform android --profile preview",
    "eas:build:android:prod": "eas build --platform android --profile production",
    "eas:build:ios:prod": "eas build --platform ios --profile production",
    "eas:submit:android": "eas submit --platform android --latest",
    "eas:submit:ios": "eas submit --platform ios --latest",
    "deploy:firestore:rules": "firebase deploy --only firestore:rules",
    "deploy:firestore:indexes": "firebase deploy --only firestore:indexes",
    "deploy:firestore": "firebase deploy --only firestore",
    "prod:check": "npm run lint && npm run typecheck && npm test",
    "prod:precheck": "node ./scripts/prod-precheck.js",
    "gradle": "node scripts/gradlew.js",
    "build:android:apk:arm64": "node scripts/gradlew.js assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "test:reader": "tsx lib/reader.selftest.ts",
    "test:responsive": "tsx lib/responsive.selftest.ts",
    "test:typescale": "tsx lib/typeScale.selftest.ts",
    "test:roaddistance": "tsx lib/family/roadDistance.selftest.ts",
    "test:shelf": "tsx lib/shelf.selftest.ts",
    "test:archive": "tsx lib/archive.selftest.ts",
    "test:callmode": "tsx lib/call/mode.selftest.ts",
    "test:games": "eslint components/games app/games.tsx lib/games && tsx lib/games/history.selftest.ts && tsx lib/games/gamesNative.selftest.ts && tsx lib/games/fairness.selftest.ts && tsx lib/games/invite.selftest.ts && tsx lib/games/liveTables.selftest.ts && tsx lib/games/handGroups.selftest.ts && tsx lib/games/meldHint.selftest.ts && tsx lib/games/rummyTable.selftest.ts && tsx lib/games/voiceMesh.selftest.ts && tsx lib/games/leaderboard.selftest.ts",
    "check:sdk": "node scripts/check-sdk-versions.js"
  },
