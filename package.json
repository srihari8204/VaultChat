{
  "name": "vaultchat",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:e2ee": "tsx services/crypto/e2ee.selftest.ts && tsx services/crypto/senderKey.selftest.ts && tsx services/crypto/shamir.selftest.ts && tsx services/security/safetyNumber.selftest.ts && tsx services/crypto/vectors.selftest.ts && tsx services/crypto/vaultbeam-vectors.selftest.ts && tsx services/crypto/parity.selftest.ts && tsx services/crypto/vaultbeam-parity.selftest.ts",
    "test:vaultcheck": "tsx lib/vaultcheck/vaultcheck.selftest.ts",
    "test:crypto:vectors": "tsx services/crypto/vectors.selftest.ts",
    "test:vaultbeam:vectors": "tsx services/crypto/vaultbeam-vectors.selftest.ts",
    "test:crypto:parity": "tsx services/crypto/parity.selftest.ts",
    "test:vaultbeam:parity": "tsx services/crypto/vaultbeam-parity.selftest.ts",
    "prebuild": "expo prebuild --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:android:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "build:android:aab": "expo prebuild --platform android --clean && cd android && ./gradlew bundleRelease",
    "eas:build:android:preview": "eas build --platform android --profile preview",
    "eas:build:android:prod": "eas build --platform android --profile production",
    "eas:build:ios:prod": "eas build --platform ios --profile production",
    "eas:submit:android": "eas submit --platform android --latest",
    "eas:submit:ios": "eas submit --platform ios --latest",
    "deploy:firestore:rules": "firebase deploy --only firestore:rules",
    "deploy:firestore:indexes": "firebase deploy --only firestore:indexes",
    "deploy:firestore": "firebase deploy --only firestore",
    "prod:check": "npm run lint && npm run typecheck",
    "prod:precheck": "node ./scripts/prod-precheck.js"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.39.0",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
