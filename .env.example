# .env.example — the app's build-time environment, keys only.
#
# Copy to `.env` and fill in. Every key here is OPTIONAL: the app runs with an
# empty .env, and each line below says what changes when it is unset. Nothing
# in this file is a secret — EXPO_PUBLIC_* is compiled into the JS bundle and
# is readable by anyone holding the APK. Never put a credential here.
#
# NOT AN ENV VAR: the API address. It is `constants/server.ts` SERVER_URL,
# hardcoded to https://api.corefinite.com. Point a build somewhere else by
# editing that file, not by adding a key here.
#
# TWO FILES THIS ONE CANNOT REPLACE, both gitignored and both needed for a
# release build:
#   google-services.json    app.json's android.googleServicesFile points at it
#                           and the google-services Gradle plugin fails without
#                           it. FCM — and therefore call ringing — needs it.
#   keystore.properties + vaultchat-release.jks
#                           only for `assembleRelease`. A debug build is fine
#                           without them; the config plugin tolerates the
#                           absence rather than failing prebuild.
# Get both from the project owner. They cannot be regenerated.

# Which environment the client reports (app/_layout.tsx). Unset = development.
EXPO_PUBLIC_ENV=

# Sentry crash reporting. Unset = no crash reports are sent, app unaffected.
EXPO_PUBLIC_SENTRY_DSN=

# ── transport ────────────────────────────────────────────────────────
# Percentage of launches that use the Rust CC-Wire carrier (lib/featureFlags).
# Unset = the JS carrier.
EXPO_PUBLIC_FLAG_TRANSPORT_RUST_PCT=

# WebTransport endpoint for CC-Wire (lib/socket.ts). LEAVE THIS UNSET unless a
# WebTransport listener is actually deployed and reachable. When it is set and
# nothing answers, cold start burns the native 8s QUIC connect timeout before
# falling back — measured at ~9s of a 13.4s cold start. See .env.production.
EXPO_PUBLIC_CCWIRE_WEBTRANSPORT_URL=

# ── native backends: 'rust' picks the native core, unset keeps JS ────
EXPO_PUBLIC_CRYPTO_BACKEND=
EXPO_PUBLIC_MONEY_BACKEND=
EXPO_PUBLIC_VAULTBEAM_NATIVE_BACKEND=

# Allow the app to run on an emulator (services/securityService.ts). Unset =
# emulators are refused, which is what a release build should do.
EXPO_PUBLIC_ALLOW_EMULATOR=
