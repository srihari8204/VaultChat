{
  "expo": {
    "name": "VaultChat",
    "slug": "VaultChat",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vaultchat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "VaultChat needs camera for video calls and face scan",
        "NSMicrophoneUsageDescription": "VaultChat needs microphone for voice and video calls",
        "NSSpeechRecognitionUsageDescription": "VaultChat uses speech recognition to transcribe your voice into text",
        "NSFaceIDUsageDescription": "VaultChat uses Face ID to protect your messages",
        "NSContactsUsageDescription": "VaultChat needs contacts to find people you know",
        "NSLocationWhenInUseUsageDescription": "VaultChat needs location to share your position with contacts",
        "NSPhotoLibraryUsageDescription": "VaultChat needs photo access to send and save media",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "VaultChat shares your location with your Family Space circle so they can see you are safe. This continues in the background only while location sharing is switched on.",
        "NSLocationAlwaysUsageDescription": "VaultChat shares your location with your Family Space circle while location sharing is switched on.",
        "NSMotionUsageDescription": "VaultChat uses motion to tell whether you are moving, so Family Space can slow location updates when you are still and save battery.",
        "UIBackgroundModes": [
          "location"
        ]
      },
      "bundleIdentifier": "com.vaultchat.app"
    },
    "android": {
      "package": "com.vaultchat.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.NFC",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "versionCode": 14
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4A9FFF",
          "sounds": [
            "./assets/sounds/note_chime.wav",
            "./assets/sounds/note_bell.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VaultChat shares your location with your Family Space circle so they can see you are safe.",
          "locationWhenInUsePermission": "VaultChat shares your location with your Family Space circle so they can see you are safe.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "corefinite-tech-solutions-llp",
          "uploadSourceMaps": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "VaultChat needs camera for Face ID",
          "enableMicrophonePermission": false
        }
      ],
      "./plugins/withAppComponentFactoryFix.js",
      "./plugins/withVaultChatCalls.js",
      "./plugins/withVaultBeamStream.js",
      "./plugins/withVaultChatSync.js",
      "./plugins/withGradleMemory.js",
      "./plugins/withCryptoCore.js",
      "./plugins/withVaultBeamRust.js",
      "./plugins/withVaultView.js",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "144570a3-de88-48f0-b7e1-ecda63618199"
      }
    },
    "owner": "srihari9999",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/144570a3-de88-48f0-b7e1-ecda63618199"
    }
  }
}
