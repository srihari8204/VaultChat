rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — owner read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-collections under user
      match /loginHistory/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /scheduledMessages/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /bookmarks/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /securityEvents/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /alerts/{docId} {
        allow read, write: if request.auth != null;
      }
      match /privacyRules/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Chats — participants only
    match /chats/{chatId} {
      allow read, write: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
      match /polls/{pollId} {
        allow read, write: if request.auth != null;
      }
      match /vaultbeam/{transferId} {
        allow read, write: if request.auth != null;
      }
    }

    // Channels — authenticated users can read, admin can write
    match /channels/{channelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.adminUid;

      match /posts/{postId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Invite Links — authenticated users
    match /inviteLinks/{linkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;
    }

    // Sticker Packs — owner write, all read
    match /stickerPacks/{packId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }

    // REMOVED: a second `match /users/{userId}` granting
    //   allow read: if request.auth != null;
    //
    // Firestore ORs match blocks — it does not take the most specific, and a
    // later block does not "refine" an earlier one. So this block silently
    // overrode the owner-only rule at the top of this file and made EVERY user
    // document readable by ANY signed-in user: profile, phone, email, whatever
    // the document holds. The intent ("public lookup for VaultID search") was
    // reasonable; the mechanism granted far more than it needed.
    //
    // If public lookup is genuinely required, it must NOT be done by re-matching
    // the private collection. Publish a deliberate projection — e.g.
    // /publicProfiles/{userId} holding only the fields meant to be searchable —
    // and grant read on that. Then "public" is a decision about which fields to
    // copy, not a rule that exposes the whole document.
    //
    // Nothing in this app reads it today: there are no Firebase client packages
    // in package.json and no `firebase/firestore` imports anywhere in the source
    // tree. The Go backend uses Firebase for FCM only, never Firestore.
  }
}
