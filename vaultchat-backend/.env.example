# ── HTTP ──────────────────────────────────────────────────────
PORT=3000

# ── Postgres (Phase 1 auth) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=6432
DB_NAME=vaultchat
DB_USER=vaultchat_user
DB_PASS=replace-me
# Optional: max ms a single statement may run before being aborted.
PG_STATEMENT_TIMEOUT=10000

# ── Redis (Phase 1 OTP rate limit) ────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=replace-me

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-64-char-random-string
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 days

# ── Email (Resend transactional API) ──────────────────────────
# Get key at https://resend.com/api-keys after verifying your domain.
# Free tier: 3,000 emails/month, no card required.
RESEND_API_KEY=re_REPLACE_ME
# Sender — must be on a domain verified in your Resend account.
EMAIL_FROM=VaultChat <noreply@corefinite.com>

# ── Twilio SMS (phone OTP — Day 17) ──────────────────────────
# Optional. Without these, /auth/send-otp-phone logs the code to stdout
# (dev mode). Use a Messaging Service SID for multi-country sending OR
# a single E.164 number for development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ── Google Sign-In ────────────────────────────────────────────
# Same Web Client ID the mobile app uses in authService.ts.
# Without this set, /auth/google still verifies signatures but
# does not enforce audience — set in production.
GOOGLE_WEB_CLIENT_ID=207307621485-53m82dlcolfctpfagjnddnsq1euvvmpe.apps.googleusercontent.com

# ── PII vault (internal/vault) — REQUIRED, no defaults ────────
# Both are read by go-api and by vaultchat-backend/lib/vault.js, and the two
# MUST agree byte-for-byte: rows written by one backend are decrypted by the
# other (TestVaultInterop).
#
# VAULTCHAT_MASTER_KEY encrypts the *_cipher columns (first_name, last_name,
# email, phone, dob, status). 32 bytes, hex OR base64. Rotating it makes every
# existing ciphertext undecryptable — there is no re-wrap job.
#   openssl rand -hex 32
VAULTCHAT_MASTER_KEY=
#
# VAULTCHAT_LOOKUP_PEPPER keys the searchable digests: users.email_lookup /
# phone_lookup (sign-in by email or phone) and refresh_tokens.token_lookup
# (migration 127). Changing it orphans every existing lookup row — sign-in by
# email/phone stops finding accounts. Unset, /auth/lookup answers 500.
VAULTCHAT_LOOKUP_PEPPER=

# ── Misc ──────────────────────────────────────────────────────
APP_URL=https://vaultchat.app
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/serviceAccountKey.json
# LOG_SQL=1   # uncomment to log every SQL query (dev only)

# Admin Console — required for /api/admin/* and admin socket auth.
# Generate a strong random value, e.g.:  openssl rand -hex 32
ADMIN_KEY=

# ── Data retention (internal/jobs) ────────────────────────────
# The server keeps every message body forever by default, which is why a
# reinstall can re-download a user's entire history from GET /chats/delta.
# These knobs bound that. Both sweeps are batched and safe to run in prod.
#
# ⚠️ IRREVERSIBLE. Enabling delete-on-delivery nulls message bodies once every
# recipient has acknowledged delivery. Purged bodies do not come back if you
# turn it off again.
#
# ⚠️ THE PREVIOUS ROLLOUT ADVICE HERE WAS BACKWARDS AND HAS BEEN REMOVED.
# It said to "set a long MAX_AGE_DAYS first, then enable delete-on-delivery".
# That is the most dangerous possible order. MAX_AGE_DAYS is the UNCONDITIONAL
# purge: it does not consult delivery at all, so it destroys the body of a
# message nobody ever received, purely because it got old. DELETE_ON_DELIVERY is
# the safe one — its predicate refuses to touch a row while any active member or
# device is still behind it, at any age. Enabling the safe sweep is step one;
# the age purge is not a step at all unless you specifically want a hard ceiling.
#
# Correct rollout:
#   1. confirm client backups are working (an uninstall must be recoverable —
#      see lib/backupScheduler; the server copy is no longer a history archive)
#   2. DELETE_ON_DELIVERY=true, leave MAX_AGE_DAYS at 0
#   3. watch the "[delete-on-delivery] purged N" log line and the DB size
#
# Clients keep what they already cached: lib/localDb upserts with
# COALESCE(excluded.content, messages.content), so a later null from the server
# never wipes a body the device already holds.
DELETE_ON_DELIVERY=false
# Seconds after DELIVERY before a body is eligible. Default 10800 (3h) — the
# retention promise the product states. Not clamped to the 30-day floor: that
# floor guards the paths that ignore delivery, and this one does not.
DELETE_ON_DELIVERY_GRACE_SEC=10800
# Hard age ceiling, applied whether or not delivery was acknowledged.
# 0 = disabled, and 0 is almost certainly what you want: any non-zero value can
# destroy a message that was never delivered. Clamped up to the 30-day floor if
# set lower.
DELETE_ON_DELIVERY_MAX_AGE_DAYS=0
# How long a device may be silent before the sweep stops waiting for it. Guards
# multi-device accounts: the first device to ack advances the shared pointer, so
# this window is what protects the second handset. Clamped UP to the retention
# floor (30), so lower values are ignored. Raise it if your users are commonly
# away from a second device for more than a month.
DELETE_ON_DELIVERY_DEVICE_STALE_DAYS=90

# Attachment bytes are purged once every recipient has fetched them, or after
# this many days, whichever comes first. Metadata rows stay so bubbles render.
# Already enabled by default — listed here so the value is explicit.
MEDIA_TTL_DAYS=14

# ── Cold-sync guard (internal/routes/chats.go) ────────────────
# GET /chats/delta?since=0 is a full-history export. A fresh install legitimately
# asks for it, but so does a stolen token. When a device presents since=0 and the
# server has never seen that device id, the response is capped at this many of
# the most recent messages and a security event is recorded.
# 0 = no cap (the pre-hardening behaviour).
COLD_SYNC_MAX_MESSAGES=2000
# Warn-only mode: record the security event but do NOT cap the response. Leave
# this true until the hardened APK has meaningful adoption, so clients that
# predate device registration keep syncing normally.
COLD_SYNC_WARN_ONLY=true

# ── Broadcast / LiveKit Egress ────────────────────────────────────────
# Egress turns a LiveKit room into HLS. Without it a broadcast is created,
# a room exists, and no playlist is ever written.
#
# VERSION MUST MATCH THE RUNNING livekit-server. Egress has its own release
# line and its tags do NOT track the server's — read the server's version and
# set the egress release LiveKit documents as compatible.
LIVEKIT_EGRESS_VERSION=
# How egress reaches livekit-server. livekit runs network_mode: host, so from
# inside the compose network that is host.docker.internal, not `livekit`.
LIVEKIT_EGRESS_WS_URL=
LIVEKIT_EGRESS_INSECURE=
# Where HLS segments land. These MUST match what internal/livekit/egress.go
# signs segment_outputs with, or the playlist is written somewhere the viewer's
# URL does not point at.
BROADCAST_BUCKET=
S3_REGION=
# Public origin the playlist is served from — PlaybackURL() builds
# <base>/<broadcastID>/index.m3u8 from it.
BROADCAST_CDN_BASE=
# Optional RTMP restream targets, comma-separated. Each already contains its
# stream key, so this is a SECRET.
BROADCAST_RTMP_URLS=
# Egress is the only CPU-bound service in the stack and shares a box with
# Postgres; leaving it unbounded lets one runaway transcode starve the database.
EGRESS_CPUS=
EGRESS_MEMORY=

# ── Object storage (MinIO dev / Cloudflare R2 prod) ────────────────────
#
# READ THIS: these are NOT read from this file by docker compose.
#
# docker-compose.yml sets S3_* under `environment:`, which overrides
# `env_file:` — and a ${VAR:-default} is still an `environment:` entry, so the
# default wins over anything here. Compose interpolates ${VAR} from the
# PROJECT-ROOT .env (./.env, beside docker-compose.yml) or the host shell.
#
# So: to point the deployment at R2, put these in the ROOT .env. Putting them
# here changes nothing, silently.
#
# One root .env feeds BOTH go-api and the LiveKit egress block, which is what
# stops the two halves of object storage drifting apart during a cutover.
#
# S3_PUBLIC_ENDPOINT must stay an S3-API host, NOT an r2.dev public URL —
# presigned SigV4 here is path-style /<bucket>/<key>.
#
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=vaultchat-media
# S3_REGION=auto            # R2 requires "auto"; MinIO ignores region
# S3_ACCESS_KEY=<R2 token access key id>
# S3_SECRET_KEY=<R2 token secret>
# BROADCAST_BUCKET=vaultchat-broadcast
