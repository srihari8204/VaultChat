# ── HTTP ──────────────────────────────────────────────────────
PORT=3000

# ── Postgres (Phase 1 auth) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=6432
DB_NAME=vaultchat
DB_USER=vaultchat_user
DB_PASS=replace-me
# Optional: max ms a single statement may run before being aborted.
PG_STATEMENT_TIMEOUT=10000

# ── Redis (Phase 1 OTP rate limit) ────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=replace-me

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-64-char-random-string
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 days

# ── Email (Resend transactional API) ──────────────────────────
# Get key at https://resend.com/api-keys after verifying your domain.
# Free tier: 3,000 emails/month, no card required.
RESEND_API_KEY=re_REPLACE_ME
# Sender — must be on a domain verified in your Resend account.
EMAIL_FROM=VaultChat <noreply@corefinite.com>

# ── Google Sign-In ────────────────────────────────────────────
# Same Web Client ID the mobile app uses in authService.ts.
# Without this set, /auth/google still verifies signatures but
# does not enforce audience — set in production.
GOOGLE_WEB_CLIENT_ID=207307621485-53m82dlcolfctpfagjnddnsq1euvvmpe.apps.googleusercontent.com

# ── Misc ──────────────────────────────────────────────────────
APP_URL=https://vaultchat.app
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/serviceAccountKey.json
# LOG_SQL=1   # uncomment to log every SQL query (dev only)
