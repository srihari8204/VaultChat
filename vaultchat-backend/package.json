{
  "name": "vaultchat-backend",
  "version": "1.0.0",
  "description": "VaultChat Backend Server",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "start:dist": "node dist/server.js",
    "dev": "nodemon server.js",
    "build": "node build.js",
    "migrate": "node migrate.js",
    "migrate:status": "node migrate.js status",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production",
    "pm2:restart": "pm2 restart vaultchat-backend",
    "pm2:stop": "pm2 stop vaultchat-backend",
    "pm2:delete": "pm2 delete vaultchat-backend",
    "pm2:logs": "pm2 logs vaultchat-backend",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "lint:syntax": "node -e \"const{execSync}=require('child_process'),fs=require('fs');const files=['server.js',...fs.readdirSync('routes').filter(f=>f.endsWith('.js')).map(f=>'routes/'+f)];for(const f of files){try{execSync(`node --check ${f}`,{stdio:'inherit'})}catch(e){process.exit(1)}}console.log('Backend syntax OK')\"",
    "health": "curl -fsS http://localhost:${PORT:-3002}/health || exit 1",
    "postinstall": "echo 'Backend deps installed.'",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@sentry/node": "^8.55.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^9.14.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "pg": "^8.13.1",
    "resend": "^4.8.0",
    "socket.io": "^4.6.1",
    "uuid": "^13.0.0",
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "nodemon": "^3.0.1"
  }
}
