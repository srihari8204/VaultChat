# The migration runner, and only the migration runner.
#
# migrate.js is kept rather than ported to Go, deliberately. It carries a
# specific ledger contract — schema_migrations(version, filename, checksum),
# sha256 over CRLF-normalised text, one transaction per file — and the live
# database is at migration 126 with 128 files on disk. A reimplementation that
# computes one checksum differently reports every applied migration as drifted.
# That is a rewrite to schedule on its own, not one to fold into a platform
# migration.
#
# So this image exists to run that proven script and nothing else: no server, no
# routes, and only the two dependencies the runner actually uses.
FROM node:22-bookworm-slim

WORKDIR /app

# pg and dotenv only. The full backend install pulls bcrypt and @node-rs/argon2,
# which need a toolchain and are irrelevant to applying SQL.
RUN npm install --no-save --omit=dev pg@8 dotenv@16

COPY migrate.js ./
COPY migrations ./migrations

USER node
ENTRYPOINT ["node", "migrate.js"]
CMD ["status"]
