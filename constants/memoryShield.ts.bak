// constants/memoryShield.ts — MemoryShield: Instant Data Destruction
import AsyncStorage from '@react-native-async-storage/async-storage';
import * as SecureStore from 'expo-secure-store';
import * as Crypto from 'expo-crypto';
import { Alert } from 'react-native';

export interface DestructionLog {
  timestamp: number;
  itemsDestroyed: number;
  certificate: string;
  reason: 'manual' | 'panic' | 'breach' | 'timeout' | 'failedlogin';
}

export interface ShieldStatus {
  isArmed: boolean;
  autoDestructEnabled: boolean;
  autoDestructMinutes: number;
  panicWordEnabled: boolean;
  panicWord: string;
  failedLoginLimit: number;
  lastActivity: number;
  destructionLog: DestructionLog[];
}

const SHIELD_KEY = 'vaultchat_shield_status';
const DESTRUCTION_LOG_KEY = 'vaultchat_destruction_log';

// All keys that will be destroyed
const SECURE_STORE_KEYS = [
  'vaultchat_private_key',
  'vaultchat_face_key',
  'vaultchat_session',
  'vaultchat_master_key',
  'vaultchat_backup_key',
];

const ASYNC_STORAGE_KEYS = [
  'vaultchat_vault_id',
  'vaultchat_enrolled_faces',
  'vaultchat_messages',
  'vaultchat_contacts',
  'vaultchat_settings',
  'vaultchat_shield_status',
  'vaultchat_chats',
  'vaultchat_media',
  'vaultchat_trust_scores',
  'vaultchat_communities',
];

// Generate destruction certificate
const generateDestructionCertificate = async (reason: string, itemCount: number): Promise<string> => {
  const payload = {
    timestamp: Date.now(),
    reason,
    itemsDestroyed: itemCount,
    certificate: 'VAULTCHAT-MEMORYSHIELD-V1',
    hash: await Crypto.digestStringAsync(
      Crypto.CryptoDigestAlgorithm.SHA256,
      reason + Date.now().toString() + itemCount.toString()
    ),
  };
  return Buffer.from(JSON.stringify(payload)).toString('base64');
};

// NUCLEAR OPTION — destroy everything
export const executeMemoryShield = async (
  reason: 'manual' | 'panic' | 'breach' | 'timeout' | 'failedlogin' = 'manual'
): Promise<DestructionLog> => {
  let itemsDestroyed = 0;

  // Step 1: Destroy all secure store keys (private keys, biometrics)
  for(const key of SECURE_STORE_KEYS){
    try {
      await SecureStore.deleteItemAsync(key);
      itemsDestroyed++;
    } catch(e){ /* already gone */ }
  }

  // Step 2: Overwrite with random data before deletion (extra security)
  for(const key of SECURE_STORE_KEYS){
    try {
      const randomData = await Crypto.digestStringAsync(
        Crypto.CryptoDigestAlgorithm.SHA256,
        Math.random().toString()
      );
      await SecureStore.setItemAsync(key, randomData);
      await SecureStore.deleteItemAsync(key);
    } catch(e){ /* ignore */ }
  }

  // Step 3: Destroy all AsyncStorage data
  for(const key of ASYNC_STORAGE_KEYS){
    try {
      await AsyncStorage.removeItem(key);
      itemsDestroyed++;
    } catch(e){ /* already gone */ }
  }

  // Step 4: Clear ALL remaining AsyncStorage
  try {
    await AsyncStorage.clear();
    itemsDestroyed += 5;
  } catch(e){ /* ignore */ }

  // Step 5: Generate blockchain destruction certificate
  const certificate = await generateDestructionCertificate(reason, itemsDestroyed);

  const log: DestructionLog = {
    timestamp: Date.now(),
    itemsDestroyed,
    certificate,
    reason,
  };

  // Step 6: Save only the destruction log (proof it happened)
  try {
    const existing = await AsyncStorage.getItem(DESTRUCTION_LOG_KEY);
    const logs = existing ? JSON.parse(existing) : [];
    logs.push(log);
    await AsyncStorage.setItem(DESTRUCTION_LOG_KEY, JSON.stringify(logs.slice(-5)));
  } catch(e){ /* ignore */ }

  return log;
};

// Load shield status
export const loadShieldStatus = async (): Promise<ShieldStatus> => {
  try {
    const data = await AsyncStorage.getItem(SHIELD_KEY);
    if(data) return JSON.parse(data);
  } catch(e){ /* ignore */ }
  return {
    isArmed: true,
    autoDestructEnabled: false,
    autoDestructMinutes: 60,
    panicWordEnabled: false,
    panicWord: '',
    failedLoginLimit: 3,
    lastActivity: Date.now(),
    destructionLog: [],
  };
};

// Save shield status
export const saveShieldStatus = async (status: ShieldStatus): Promise<void> => {
  await AsyncStorage.setItem(SHIELD_KEY, JSON.stringify(status));
};

// Load destruction logs
export const loadDestructionLogs = async (): Promise<DestructionLog[]> => {
  try {
    const data = await AsyncStorage.getItem(DESTRUCTION_LOG_KEY);
    return data ? JSON.parse(data) : [];
  } catch(e){ return []; }
};

// Check panic word
export const checkPanicWord = async (input: string): Promise<boolean> => {
  const status = await loadShieldStatus();
  if(!status.panicWordEnabled || !status.panicWord) return false;
  return input.toLowerCase().trim() === status.panicWord.toLowerCase().trim();
};

// Update last activity
export const updateActivity = async (): Promise<void> => {
  const status = await loadShieldStatus();
  status.lastActivity = Date.now();
  await saveShieldStatus(status);
};

// Check if auto-destruct should trigger
export const checkAutoDestruct = async (): Promise<boolean> => {
  const status = await loadShieldStatus();
  if(!status.autoDestructEnabled) return false;
  const elapsed = Date.now() - status.lastActivity;
  const limit = status.autoDestructMinutes * 60 * 1000;
  return elapsed > limit;
};

export const reasonLabels = {
  manual:     '👤 Manual Trigger',
  panic:      '🚨 Panic Word',
  breach:     '⚠️ Breach Detected',
  timeout:    '⏱️ Auto-Destruct Timeout',
  failedlogin:'🔒 Failed Login Limit',
};
