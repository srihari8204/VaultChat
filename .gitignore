# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android


vaultchat-backend/.env
vaultchat-backend/serviceAccountKey.json
.env
*.env

.env.local

# Build scripts & backups
*.backup
add_*.js
fix_*.js
*.ghost-backup
*.vo-backup

# Expo export bundle (build artifact)
dist-export/

# Never commit ship tarballs / build archives
*.tgz
*.tar.gz
*.zip
*.aab
*.apk

# build logs (session artifacts)
build_release*.log

# Local build/dev-server logs (scripts/gradlew.js, expo start)
.build.log
.build-debug.log
.metro.log

# Release signing — the keystore CANNOT be regenerated after the first Play
# upload. Back these up off this machine; never commit them.
vaultchat-release.jks
keystore.properties

# adb logcat captures — large, machine-specific, never useful in git
.device.log
*.device.log
.shot.png
# ...and the dated per-session capture dirs (logs-YYYY-MM-DD/<serial>-full.log).
# One session was 14 MB across three devices, and a raw full logcat carries
# tokens, phone numbers and chat metadata straight out of a real handset.
logs-20*/

# code-graph-rag local caches (machine-specific, never shared)
.cgr-dir-mtimes.json
.cgr-hash-cache.json
.cgr-parser-fingerprint

# device-test capture output (hundreds of MB of logcat, machine-local)
p2p-device-tests/
# generated audit reports
docs/audit/

# Rust spike build output (rust/vaultcore) — never committed
rust/**/target/

# nav-core Rust build output (same as the crypto/vaultbeam crates)
services/nav/rust/target/
vaultchat-backend-go/api.exe

# Firebase app config. Ships inside every APK by design (the Android API key is
# restricted by package name + signing-cert SHA-1, not by secrecy), but it names
# the prod project and it does not belong in source control. Provision it in CI
# / EAS as a secret file. See SECRETS.md.
google-services.json
GoogleService-Info.plist
