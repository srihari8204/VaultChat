# VaultChat proxy — Go-first (Phase 2 migration COMPLETE).
#
# go-api owns the ENTIRE client-facing surface: every REST module, /health,
# and Socket.IO (incl. the websocket upgrade — reverse_proxy handles the
# Upgrade handshake transparently). The Node API process is NOT required and is
# not routed. Since the VaultLens removal took the vaultlens-worker with it,
# NO Node process runs at all.
#
# Rollback to Node for any path (requires the Node api container running):
#   @name path /route /route/*
#   reverse_proxy @name api:3000
# placed ABOVE the default block, then `docker compose restart caddy`.

:80 {
	encode gzip

	# Three MUTUALLY EXCLUSIVE handle blocks, evaluated in the order written.
	# `handle` rather than bare directives on purpose: bare directives are
	# reordered by Caddy's own directive order, which is fine when there is one
	# of each but becomes something you have to reason about the moment a second
	# route appears. handle blocks are explicit and read top to bottom.

	# The internal emit bridge must NEVER be reachable from outside — refuse
	# it at the proxy regardless of which backend owns it.
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	# ── LiveKit signalling → the SFU (docs/SFU_DEPLOY.md) ────────────
	# ONLY the WebSocket/HTTP signalling comes through here, so the client gets
	# TLS from the same certificate as the API and the SFU needs no hostname of
	# its own. MEDIA does NOT: RTC uses UDP 7882 / TCP 7881 straight to the
	# host. Proxying media would put Caddy in the path of every packet, which is
	# the opposite of what an SFU is for.
	#
	# host.docker.internal, not a service name: livekit runs with
	# network_mode: host because RTC must advertise the host's real address in
	# its ICE candidates. The caddy service carries an extra_hosts mapping for
	# it — on Linux that name does not resolve without one.
	@livekit path /livekit /livekit/*
	handle @livekit {
		uri strip_prefix /livekit
		reverse_proxy host.docker.internal:7880
	}

	# ── Go Live signalling → the SEPARATE broadcasting SFU ───────────
	# A DIFFERENT PATH TO A DIFFERENT PORT. /livekit above is calling's SFU on
	# 7880; this is the Go Live deployment on 7890 (livekit/golive.yaml). Two
	# isolated media servers need two routes — sharing one would mean sharing a
	# server, which is exactly what the split exists to prevent.
	#
	# Same rule as above: ONLY signalling comes through Caddy, so the client
	# gets TLS from the API's certificate and the Go Live SFU needs no hostname
	# of its own. MEDIA does not — Go Live RTC is UDP 7892 / TCP 7891 straight
	# to the host, and those ports must be open alongside calling's 7882/7881.
	#
	# GOLIVE_LIVEKIT_URL is what this serves: wss://<host>/golive-livekit
	@golive path /golive-livekit /golive-livekit/*
	handle @golive {
		uri strip_prefix /golive-livekit
		reverse_proxy host.docker.internal:7890
	}

	# ── Android App Links: /live/join/<code> opens the app, not a browser ──
	#
	# Android's verifier fetches this over https and compares the release signing
	# cert against app.json's autoVerify intent filter. Without it the Private
	# Live invitation link opens a browser tab that nothing serves.
	#
	# SERVED FROM A FILE, NOT AN INLINE `respond`. The fingerprint list MUST gain
	# Play's app-signing SHA-256 after the first upload or every invitation link
	# silently breaks — see caddy/public/README.md for why and how. Keeping it in
	# the bind mount means that fix is a one-line JSON edit that takes effect
	# immediately, instead of a server-config change plus a Caddy restart.
	@assetlinks path /.well-known/assetlinks.json
	handle @assetlinks {
		root * /srv/public
		rewrite * /assetlinks.json
		header Content-Type application/json
		file_server
	}

	# ── Play-required legal pages ────────────────────────────────────
	#
	# Google Play will not publish an app that handles personal data without a
	# reachable privacy policy URL, and an app with accounts must also give a
	# web address where deletion can be requested by someone who cannot open the
	# app. Both are fetched by Google during review, so they have to be real
	# pages on a real host — not a doc in the repo.
	#
	# From a bind mount rather than inline `respond` (the assetlinks trick
	# above): these are documents that will be edited by a human, and a policy
	# escaped into a Caddyfile string is a policy nobody will keep accurate.
	# Extensionless paths so the printed URLs stay clean.
	#
	# /terms is the third: an app with accounts needs a recorded terms
	# acceptance, and a recorded acceptance is worthless if the thing accepted
	# is not reachable at a stable URL. The app records WHICH version a user
	# accepted (VAULTCHAT_TERMS_VERSION); this page is what that version names.
	@legal path /privacy /privacy.html /terms /terms.html /delete-account /delete-account.html
	handle @legal {
		root * /srv/public
		rewrite /privacy /privacy.html
		rewrite /terms /terms.html
		rewrite /delete-account /delete-account.html
		header Content-Type "text/html; charset=utf-8"
		file_server
	}

	# ── Maps → its own container, core as the fallback ───────────────
	# openspec: microservices-maps-pilot. maps-api is the same image as go-api
	# started with SERVICES=maps; go-api still serves /nav/* too.
	#
	# lb_policy first + active health checks: every request goes to maps-api
	# while its /livez answers, and to go-api the moment it does not (a stopped
	# container fails within one 5 s interval; lb_try_duration retries a request
	# that hit it in between). /livez touches nothing, so a slow database never
	# flips traffic. Undo the move by deleting this block and reloading Caddy.
	@maps path /nav/*
	handle @maps {
		reverse_proxy maps-api:4000 go-api:4000 {
			lb_policy first
			lb_try_duration 5s
			fail_duration 30s
			health_uri /livez
			health_interval 5s
		}
	}

	# ── everything else → Go ─────────────────────────────────────────
	handle {
		reverse_proxy go-api:4000
	}
}
