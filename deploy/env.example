# ═══════════════════════════════════════════════════════════════════════════
#  VaultChat — every variable the stack needs
# ═══════════════════════════════════════════════════════════════════════════
#
# THERE ARE TWO ENV FILES AND THEY ARE NOT INTERCHANGEABLE. This is the single
# most expensive thing to get wrong here, so it is the first thing written:
#
#   ./.env                      <- read by DOCKER COMPOSE, to expand ${VAR}
#   ./vaultchat-backend/.env    <- read by the go-api CONTAINER, via env_file:
#
# Anything under a service's `environment:` key beats `env_file:` — and a
# `${VAR:-default}` IS an `environment:` entry, so when VAR is unset the
# DEFAULT materialises and still wins over the file. Concretely: putting S3_*
# in vaultchat-backend/.env changes nothing at all, silently, with no error to
# explain it. Section A below must go in ./.env or it does not take effect.
#
# Copy it in two halves:
#   awk '/SECTION A ---/,/END SECTION A/' deploy/env.example > .env
#   awk '/SECTION B ---/,/END SECTION B/' deploy/env.example > vaultchat-backend/.env
#
# Every value here is a PLACEHOLDER. Nothing in this file is a live credential.
#
# ───────────────────────────────────────────────────────────────────────────
#  ☠  IRREPLACEABLE — READ BEFORE YOU GENERATE ANYTHING
# ───────────────────────────────────────────────────────────────────────────
#
#   VAULTCHAT_MASTER_KEY      (Section B)
#   VAULTCHAT_LOOKUP_PEPPER   (Section B)
#
# These are not rotatable secrets. They are the key material for PII already
# encrypted in the database. Generate new ones against an existing database and
# every stored phone number, email and display name becomes permanently
# unreadable, and every lookup-by-phone stops matching: there is no recovery,
# no re-derivation, and no support path. Restoring a database backup does not
# help — the backup is encrypted with the SAME key you just lost.
#
# Generate ONCE, at first bring-up, and put both in a password manager before
# the first user signs up. On an existing deployment, COPY them from the
# running box; never regenerate.
#
#   openssl rand -hex 32     # both take 32 bytes, hex or base64
#
# ───────────────────────────────────────────────────────────────────────────
# This file covers what go-api and the compose stack read. `docs/ENV_INVENTORY.md`
# is the wider census — it also covers the external games server's own variables
# (GAMES_*, which belong to a binary that has no source in this repo) and the
# dead legacy keys (GIPHY_KEY, TENOR_KEY, TWILIO_*) still sitting in the box's
# env files. Nothing here needs those.
# ═══════════════════════════════════════════════════════════════════════════


# ═══ SECTION A --- ./.env ══════════════════════════════════════════════════
# Consumed by docker compose for ${VAR} expansion across all three compose
# files. A variable missing here does NOT error: compose substitutes the
# `:-default` from docker-compose.yml, which is the bench value. That is how a
# production box quietly ends up writing media to a local MinIO nobody reads.

# ── Database (go-api -> pgbouncer -> postgres) ─────────────────────────────
DB_HOST=pgbouncer                  # required. `postgres` for a direct connection (rollback path)
DB_PORT=6432                       # required. 5432 if you bypass pgbouncer
DB_PASS=CHANGE_ME_DB_PASSWORD      # required. Must match POSTGRES_PASSWORD in docker-compose.yml.
                                   #   Missing => falls back to `vaultchat_dev`, postgres refuses the
                                   #   connection, /ready returns 503 and nothing serves.

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_ADAPTER=1                    # optional (default 1). 1 = Socket.IO Redis adapter + shared
                                   #   presence, required before a second go-api replica. 0 =
                                   #   in-process only. Redis unreachable fails open either way.
SOCKET_IO_ENABLED=1                # optional (default 1). Keep 1 for admin/old-client compatibility.
                                   #   Set 0 only after the admin console and installed clients are
                                   #   confirmed on CC-Wire/WebTransport paths.
CCWIRE_WS=1                        # optional (default 0). 1 mounts /ccwire/v1 for the CC-Wire app runtime.

# ── Object store: user media (Cloudflare R2 in production) ─────────────────
# Set these in ./.env, NOT vaultchat-backend/.env. See the header.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com         # required in prod. Missing => http://minio:9000
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com  # required. The host presigned URLs are
                                   #   SIGNED for. Wrong value => every upload 403s on signature mismatch.
S3_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY_ID      # required in prod
S3_SECRET_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY  # required in prod
S3_BUCKET=vaultchat-media          # optional (default vaultchat-media)
S3_REGION=auto                     # required for R2; MinIO ignores it. Anything else and storage.go
                                   #   and egress.go sign under different SigV4 scopes on one bucket.
# MESSAGE_BODIES                   # DO NOT SET. Deliberately absent, not merely commented out.
                                   #   This flag used to default to 1 here and it was a lie: the
                                   #   ephemeral body store is REFUSED at boot (its schema caps body
                                   #   retention at 3h, against a 30-day retention floor — see
                                   #   jobs.bodyStoreRefused). Setting it to 1 on production wrote
                                   #   ZERO bodies and changed nothing except the boot log.
                                   #   Message retention is delivery-driven: see DELETE_ON_DELIVERY.
                                   #   The store is scheduled for removal, not repair.

# ── Object store: HLS broadcast segments (local MinIO — a SECOND store) ────
# Deliberately separate from S3_* above: egress writes segments to MinIO while
# user media lives on R2. Without these, go-api's playback relay authenticates
# to MinIO with R2 credentials and every segment 404s. It did exactly that.
BROADCAST_S3_ENDPOINT=http://minio:9000       # optional (defaults match the egress service)
BROADCAST_S3_ACCESS_KEY=CHANGE_ME_MINIO_USER  # optional
BROADCAST_S3_SECRET_KEY=CHANGE_ME_MINIO_PASS  # optional
BROADCAST_BUCKET=vaultchat-broadcast          # optional
MINIO_USER=CHANGE_ME_MINIO_USER    # required if MinIO runs. Also the fallback for S3_ACCESS_KEY.
MINIO_PASS=CHANGE_ME_MINIO_PASS    # required if MinIO runs.

# ── LiveKit: 1:1 and group CALLING ─────────────────────────────────────────
# The backend only SIGNS tokens; it never dials the SFU. Missing =>
# POST /calls/{id}/sfu-token answers 503 with a reason and calls fall back to
# the WebRTC mesh — degraded, not broken.
LIVEKIT_KEYS=APIxxxxxxxx: CHANGE_ME_SECRET    # required by the livekit container. Format "key: secret".
LIVEKIT_API_KEY=APIxxxxxxxx                   # required. Same key id as above.
LIVEKIT_API_SECRET=CHANGE_ME_SECRET           # required. Same secret as above.
LIVEKIT_URL=wss://api.example.com/livekit     # required. What the CLIENT dials — public wss://, via Caddy.
LIVEKIT_HTTP_URL=http://host.docker.internal:7880  # optional. Server-side room API.

# ── LiveKit: GO LIVE broadcasting — a SEPARATE project, never the pair above ─
# NO FALLBACK: absent, POST /broadcasts answers 503 rather than quietly using
# LIVEKIT_*. Setting these to the SAME key or secret is REFUSED (golive.Usable)
# — a copy-paste that re-couples broadcasting to the calling SFU is exactly how
# the isolation gets undone, so it fails loudly instead of working.
#   docker run --rm livekit/livekit-server generate-keys   # generate a SECOND pair
GOLIVE_LIVEKIT_KEYS=APIyyyyyyyy: CHANGE_ME_OTHER_SECRET
GOLIVE_LIVEKIT_API_KEY=APIyyyyyyyy
GOLIVE_LIVEKIT_API_SECRET=CHANGE_ME_OTHER_SECRET
GOLIVE_LIVEKIT_URL=wss://api.example.com/golive-livekit  # required. Port 7890's Caddy path, NOT /livekit.
GOLIVE_LIVEKIT_HTTP_URL=http://host.docker.internal:7890 # optional
GOLIVE_ROOM_PREFIX=                # optional (default "golive_"). Changing it strands in-flight rooms.
GOLIVE_HOST_GRACE=                 # optional (Go duration, e.g. 90s). Host-disconnect grace before reaping.
GOLIVE_HOST_REAPER=                # optional. `off` disables the sweep without a rollback.
GOLIVE_EGRESS_VERSION=v1.14.0      # optional. Pin it — the box runs v1.14.0.
GOLIVE_EGRESS_WS_URL=ws://host.docker.internal:7890  # optional
GOLIVE_EGRESS_INSECURE=true        # optional. true because the hop is loopback inside the host.
GOLIVE_EGRESS_CPUS=4               # FOUR IS A FLOOR. Room-composite egress refuses to run below it and
                                   #   then still logs "service ready" — so every broadcast dies in
                                   #   'starting' with nothing but one startup line to say why.
GOLIVE_EGRESS_MEMORY=2g            # optional
LIVEKIT_EGRESS_VERSION=v1.14.0     # optional. Calling's egress. Pin it.
LIVEKIT_EGRESS_WS_URL=ws://host.docker.internal:7880  # optional
LIVEKIT_EGRESS_INSECURE=true       # optional
EGRESS_CPUS=4                      # optional. Same floor as above.
EGRESS_MEMORY=2g                   # optional

# ── TURN / coturn ──────────────────────────────────────────────────────────
TURN_SECRET=CHANGE_ME_TURN_SECRET  # required for relayed calls. Must match coturn/turnserver.conf.
                                   #   Missing => no TURN credentials minted; calls behind symmetric
                                   #   NAT fail to connect at all.
TURN_EXTERNAL_IP=203.0.113.10      # required. The box's PUBLIC IPv4. Wrong => useless relay candidates.

# ── Public identity ────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://api.example.com   # required. This deployment's own origin. Missing =>
                                   #   livekit.PlaybackBase() falls through to a HARDCODED
                                   #   https://api.corefinite.com, so a bench handed phones PRODUCTION
                                   #   playback URLs. Observed on a machine that had never seen prod.
BROADCAST_CDN_BASE=                # optional. CDN hostname in front of HLS. Empty = use PUBLIC_BASE_URL.

# ── Internal bridge (strangler-era; no Node process runs any more) ─────────
INTERNAL_EMIT_KEY=CHANGE_ME_LONG_RANDOM   # required. Guards /internal/*. Caddy also 404s that prefix
                                   #   unconditionally, so this is defence in depth, not the only lock.
# END SECTION A


# ═══ SECTION B --- ./vaultchat-backend/.env ════════════════════════════════
# Loaded into the go-api container by `env_file:` (`required: false`, so a
# missing file is NOT an error — it is a container that starts and misbehaves).
# Anything compose sets under `environment:` overrides what is written here.

# ── ☠ IRREPLACEABLE — see the header ───────────────────────────────────────
VAULTCHAT_MASTER_KEY=CHANGE_ME_32_BYTES_HEX_OR_BASE64
                                   # required. AES key for encrypted PII at rest (internal/vault).
                                   #   Must decode to exactly 32 bytes or the vault refuses to open.
                                   #   REGENERATING THIS DESTROYS ALL EXISTING ENCRYPTED PII. FOREVER.
VAULTCHAT_LOOKUP_PEPPER=CHANGE_ME_32_BYTES_HEX_OR_BASE64
                                   # required. Peppers the blind-index hash used to find a user by
                                   #   phone/email without decrypting. REGENERATING IT MAKES EVERY
                                   #   EXISTING ACCOUNT UNFINDABLE — logins stop matching. FOREVER.

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES
                                   # required. go-api REFUSES TO START if empty — deliberately: an
                                   #   empty HS256 key means a token anyone can mint verifies against
                                   #   every authenticated route, i.e. a total auth bypass that
                                   #   presents as a perfectly healthy deploy. <32 chars logs a warning.
JWT_ACCESS_TTL=15m                 # optional
JWT_REFRESH_TTL=30d                # optional
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
                                   # required for Google Sign-In. Must be the SAME Web Client ID the
                                   #   mobile app ships. Missing => Google sign-in rejected; OTP still works.
ADMIN_KEY=CHANGE_ME_LONG_RANDOM    # required. Guards the admin routes and the admin socket namespace.
                                   #   Missing => those routes refuse rather than open. Fail-closed.

# ── Database / Redis (the container reads these; keep them equal to Section A) ─
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=vaultchat
DB_USER=vaultchat
DB_PASS=CHANGE_ME_DB_PASSWORD      # required. Keep identical to Section A.
PG_STATEMENT_TIMEOUT=15000         # optional (ms). Caps a runaway query.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASS=                        # empty on this deployment — which is WHY redis publishes on
                                   #   127.0.0.1 only. A 0.0.0.0 bind would put an unauthenticated
                                   #   datastore straight onto a public IP.

# ── Transactional email (OTP) ──────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME        # required for email OTP. Missing => OTP send fails and signup with
                                   #   an email address cannot complete.
EMAIL_FROM=no-reply@example.com    # required with the above. Must be a verified Resend sender.

# ── TURN (client-facing half) ──────────────────────────────────────────────
TURN_SECRET=CHANGE_ME_TURN_SECRET  # required. Same value as Section A.
TURN_HOST=turn.example.com         # required. Public hostname of coturn.
TURN_HOST6=                        # optional. IPv6 LITERAL, because turn.example.com has no AAAA
                                   #   record. Empty = IPv4-only relay.

# ── VaultBeam P2P object storage — a THIRD store, isolated on purpose ──────
# Never point these at S3_*: those are shared by user media, and repointing
# them sends attachments to a bucket that has none of them.
VAULTBEAM_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
VAULTBEAM_S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
                                   # The R2 S3 API host, NOT a custom domain: a custom domain serves
                                   #   objects without validating SigV4, so it cannot be the
                                   #   authorization boundary.
VAULTBEAM_S3_BUCKET=vaultchat-beam
VAULTBEAM_S3_REGION=auto
VAULTBEAM_S3_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY_ID
VAULTBEAM_S3_SECRET_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
                                   # All six required for VaultBeam transfers AND for the off-site
                                   #   encrypted database backup — scripts/deploy-backup-offsite.sh
                                   #   reads them back out of the container. Missing => transfers fail
                                   #   AND you have no off-site backup, which is the one you need.

# ── Content / misc ─────────────────────────────────────────────────────────
KLIPY_KEY=CHANGE_ME_KLIPY_KEY      # required for GIFs/stickers/emoji (replaced GIPHY 2026-08-23).
                                   #   Missing => the GIF picker returns empty; nothing else breaks.
                                   #   A test key is capped at 100 calls/hour — swap before launch.
VAULTCHAT_TERMS_VERSION=2026-09-13 # required. The version string an acceptance is recorded against.
                                   #   Must name a document actually served at /terms by Caddy, or the
                                   #   recorded acceptance points at nothing.
SENTRY_DSN=                        # optional. Empty = no error reporting. Not read by the Go API.
SENTRY_TRACES_SAMPLE_RATE=0.1      # optional
OLLAMA_URL=                        # optional. Local LLM for AI Guardian. Empty = feature off.
                                   #   NOTE: the box sets http://localhost:11434 and nothing listens
                                   #   there. The AI path already points at a host that is not up.
SEARXNG_URL=                       # optional. Empty = feature off.

# ── Retention, routing and trust — all optional, all defaulted ─────────────
# Every one of these has a working default in the Go source. They are listed
# because the defaults are policy decisions, and a default you did not know
# about is a policy you did not choose.
DELETE_ON_DELIVERY=                # optional. `true` enables the delete-on-delivery sweep. Empty = off.
DELETE_ON_DELIVERY_GRACE_SEC=      # optional (default 3h). How long after delivery a body is reclaimed.
                                   #   It used to default to 120s, which nothing enforced and nothing
                                   #   documented, while the policy this implements promises three hours.
DELETE_ON_DELIVERY_DEVICE_STALE_DAYS=  # optional (default 30, clamped to the retention floor). How long a
                                   #   silent device blocks reclamation before it stops being waited for.
MEDIA_TTL_HOURS=                   # optional. Attachment-byte retention ceiling. See MESSAGE_BODIES.
INVITE_SECRET=                     # optional but PREFERRED. HMAC key for invitation tokens. Empty =>
                                   #   falls back to JWT_SECRET, which means rotating invitation tokens
                                   #   invalidates every session on the platform.
TRUSTED_PROXIES=                   # optional. Comma-separated CIDRs allowed to set X-Forwarded-For.
                                   #   Empty => 127.0.0.0/8,::1/128,172.28.0.0/16,172.17.0.0/16 — the
                                   #   checked-in topology. Widen it and client IPs become spoofable.
VALHALLA_URL=                      # optional (default http://valhalla:8002). Turn-by-turn routing.
GEOCODE_UPSTREAM=                  # optional (default https://photon.komoot.io). Address search.
                                   #   Public upstream: every geocode query leaves the box.
VAULTCHAT_TERMS_URL=               # optional. Public URL of the terms document named by
                                   #   VAULTCHAT_TERMS_VERSION.
DB_SYSTEM_USER=                    # optional, and DO NOT set it casually. A BYPASSRLS role for the
DB_SYSTEM_PASS=                    #   system pool. Absent, the system pool IS the normal pool — byte
                                   #   for byte identical behaviour. It only means anything once
                                   #   scripts/enable-rls-force.sql has also been run.
# END SECTION B


# ═══ NOT ENVIRONMENT VARIABLES ═════════════════════════════════════════════
# These are FILES, mounted read-only at /run/secrets by docker-compose.prod.yml
# so the material never appears in `docker inspect`, `docker compose config`,
# the process environment, or a crash dump — only a path does. Put them in
# ./secrets/ (dir 700, files 600, owned by uid 1000 = the container's `app`
# user). A missing bind-mount source is a HARD container start failure, which is
# why that block lives in prod.yml and not in docker-compose.yml.
#
#   secrets/fcm-service-account.json  Firebase service account JSON, downloaded by
#                                     hand from the Firebase console. CANNOT be
#                                     scripted. Missing => no push notifications and
#                                     no incoming-call ring on a killed app.
#   secrets/games-signing.key         Ed25519 private key; signs VaultGames launch
#                                     tokens. Missing => the mini-app refuses every launch.
#   secrets/games-notify.pub          Ed25519 PUBLIC half, the other direction: the
#                                     games server signs turn/invite events and we
#                                     verify them. Nothing secret in it — it is mounted
#                                     alongside the others purely so the two games keys
#                                     are configured in one place and cannot drift apart.
